rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Multi-tenant household document: disallow collection listing so no one can enumerate all households
    match /households/{householdId} {
      allow list: if false;
      allow get: if true;
      allow create, update, delete: if true;

      match /{document=**} {
        allow list: if false;
        allow get, write: if true;
      }
    }
  }
}
